<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DEP-01 (flagship): System.IdentityModel.Tokens.Jwt 6.10.0. Known advisories, and the
         library CODE-01 misconfigures. The pairing is what makes the chain legible: an old JWT
         library is a finding, a disabled signature check is a finding, and together they are
         an authentication bypass. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.10.0" />

    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DEP-02: old Azure Storage SDK, pairs with the archive access in BlobArchive. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.8.0" />

    <!-- DEP-03: old HTML sanitiser with bypass advisories - the portal renders clinician notes
         as HTML, so this one is genuinely reachable. -->
    <PackageReference Include="HtmlSanitizer" Version="5.0.372" />

    <!-- DEP-04: old PDF generator used for discharge summaries, known XXE history. Pairs with
         CODE-04's XXE as a second signal on the same weakness class. -->
    <PackageReference Include="iTextSharp" Version="5.5.13.1" />

    <!-- DEP-05 (noise): test-only assertion library. Never shipped, never reachable. -->
    <PackageReference Include="FluentAssertions" Version="5.10.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
