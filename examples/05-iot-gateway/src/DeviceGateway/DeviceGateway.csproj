<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DEP-01 (flagship): System.Security.Cryptography.Xml 4.7.0, which carries a signature-
         bypass advisory.

         An earlier draft pointed at System.Private.Xml, which is not a shippable package id -
         the XXE surface CODE-01 opens lives in the BCL, so there is no "old XML package" to
         blame it on. This is the better pairing anyway: a signature-verification library with a
         signature-bypass advisory, in a fixture whose whole subject is a signature that is read
         and never checked. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="4.7.0" />

    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DEP-02: old MQTT client, pairs with CODE-04's plaintext broker. -->
    <PackageReference Include="MQTTnet" Version="3.0.13" />

    <!-- DEP-03: old AWS S3 SDK on the firmware path. -->
    <PackageReference Include="AWSSDK.S3" Version="3.3.104.29" />

    <!-- DEP-04: old compression library used to unpack firmware bundles - path-traversal
         history, and firmware bundles are archives. -->
    <PackageReference Include="SharpZipLib" Version="1.2.0" />

    <!-- DEP-05 (noise): source-generator package, build-time only, never shipped. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
