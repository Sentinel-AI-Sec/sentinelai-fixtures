<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Checked in so the SCA path resolves without a restore, as in the flagship fixture. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DEP-01 (flagship): RestSharp 106.11.7. Follows redirects by default, which is what
         turns CODE-01's SSRF from "fetches the URL you gave it" into "fetches wherever that
         URL redirects to" - including link-local addresses an allow-list on the first hop
         would have caught. -->
    <PackageReference Include="RestSharp" Version="106.11.7" />

    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DEP-02: old SqlClient, pairs with CODE-07's injection. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="2.1.1" />

    <!-- DEP-03: old YAML parser, deserialization advisories. Reachable only from the config
         loader, which no request path touches - a genuine but unreachable finding. -->
    <PackageReference Include="YamlDotNet" Version="5.3.0" />

    <!-- DEP-04: old BouncyCastle. Present transitively in a lot of payment stacks and worth
         having as a second crypto-layer signal beside CODE-05's MD5. -->
    <PackageReference Include="BouncyCastle" Version="1.8.5" />

    <!-- DEP-05 (noise): build-time analyzer package, never shipped, never reachable. Included
         so the fixture has something a reasoner should demote rather than chain. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
