<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fixture note: lock file is checked in intentionally so
         Dependency-Check's SCA path resolves (SEC-04 AC). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DEP-01 (flagship, pairs with CODE-01 CWE-502):
         old Newtonsoft.Json with a known deserialization advisory. -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.1" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- DEP-02: old regex-heavy helper lib, ReDoS-class history. -->
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />

    <!-- DEP-03: old SqlClient with known advisories. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="2.1.1" />

    <!-- DEP-04: old logging sink, known info-disclosure history. -->
    <PackageReference Include="Serilog.Sinks.File" Version="4.1.0" />

    <!-- DEP-05: old image processing lib, known DoS/memory advisories. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="1.0.4" />

    <!-- DEP-06: old JWT lib, paired with CODE weak-validation pattern. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.10.0" />

    <!-- DEP-07 (noise): low-severity, build-time-only, not reachable
         through any request path in this app. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
